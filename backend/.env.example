# Copy to .env and fill in. .env is gitignored.

# Choose ONE:
#   SQLite (zero-setup, default for dev):
DATABASE_URL=sqlite+aiosqlite:///./learning_os.db
#   Postgres (for prod-ish setup):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learning_os

# LLM backend: ollama (local, default) | anthropic
LLM_BACKEND=ollama

# Ollama — works for local and Ollama Cloud (free tier).
#   Local:  OLLAMA_BASE_URL=http://localhost:11434  (start with `ollama serve`)
#   Cloud:  OLLAMA_BASE_URL=https://ollama.com      (set OLLAMA_API_KEY below)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_S=120

# Anthropic (only used if LLM_BACKEND=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Per-user daily token budget (controls runaway cost on cloud backends)
DAILY_TOKEN_BUDGET_PER_USER=20000

# Knowledge graph location (relative to backend/ or absolute)
KNOWLEDGE_PATH=../knowledge/nodes

# Auth
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Server
APP_ENV=dev
LOG_LEVEL=INFO
