# Copy to .env and fill in. .env is gitignored.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learning_os

# LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Fallback / cost optimization
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# Per-user daily token budget (controls runaway cost)
DAILY_TOKEN_BUDGET_PER_USER=20000

# Knowledge graph location (relative to backend/ or absolute)
KNOWLEDGE_PATH=../knowledge/nodes

# Auth
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Server
APP_ENV=dev
LOG_LEVEL=INFO
